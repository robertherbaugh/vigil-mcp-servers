#!/bin/sh
# vigil-respond-nft: root helper for vigil-respond. The sudo rule allows this one file only, and it
# checks every argument again (vigil-respond may be bypassed, this may not). The blocks live in
# the nftables sets inet vigil_respond blocked4/blocked6 with per-element timeouts: a block ends
# by itself, even if the responder never comes back. Addresses in /etc/vigil-respond/never-block
# (one CIDR per line) are never blocked.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
NFT=${VIGIL_RESPOND_NFT:-nft}
NEVER=${VIGIL_RESPOND_NEVER_BLOCK:-/etc/vigil-respond/never-block}
MIN_TTL=60
MAX_TTL=86400

say() { logger -t vigil-respond -p auth.notice -- "$*" 2>/dev/null || true; }
die() { say "refused: $1"; echo "refused: $1" >&2; exit 2; }

is_ipv4() {
  printf %s "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
  IFS=.; set -- $1; unset IFS
  for o in "$@"; do [ "$o" -le 255 ] || return 1; done
}
is_ipv6() { printf %s "$1" | grep -Eq '^[0-9A-Fa-f:]{2,39}$' && printf %s "$1" | grep -q ':'; }
family() { if is_ipv4 "$1"; then echo 4; elif is_ipv6 "$1"; then echo 6; else return 1; fi; }

never_blocked() {
  # python3 for the CIDR test when it exists; else an exact-address match only.
  [ -r "$NEVER" ] || return 1
  if command -v python3 >/dev/null 2>&1; then
    python3 -I - "$1" "$NEVER" <<'PY'
import ipaddress, sys
ip = ipaddress.ip_address(sys.argv[1])
for line in open(sys.argv[2]):
    line = line.split("#", 1)[0].strip()
    if line and ip in ipaddress.ip_network(line, strict=False):
        sys.exit(0)
sys.exit(1)
PY
  else
    grep -Eq "^[[:space:]]*$1([[:space:]]|/|#|$)" "$NEVER"
  fi
}

ensure_table() {
  "$NFT" list table inet vigil_respond >/dev/null 2>&1 && return 0
  "$NFT" -f - <<'NFT'
table inet vigil_respond {
  set blocked4 { type ipv4_addr; flags timeout; }
  set blocked6 { type ipv6_addr; flags timeout; }
  chain input {
    type filter hook input priority -10; policy accept;
    ip saddr @blocked4 counter drop
    ip6 saddr @blocked6 counter drop
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    ip saddr @blocked4 counter drop
    ip6 saddr @blocked6 counter drop
  }
}
NFT
}

verb=${1:-}; shift || true
case "$verb" in
  block-ip)
    [ $# -eq 2 ] || die "block-ip <address> <seconds>"
    fam=$(family "$1") || die "not an IP address"
    case "$2" in *[!0-9]*|"") die "seconds must be a number" ;; esac
    [ "$2" -ge "$MIN_TTL" ] && [ "$2" -le "$MAX_TTL" ] || die "seconds must be $MIN_TTL to $MAX_TTL"
    if never_blocked "$1"; then die "$1 is on the never-block list"; fi
    ensure_table
    # Replace any older block on the address, so the new TTL counts from now.
    "$NFT" delete element inet vigil_respond "blocked$fam" "{ $1 }" >/dev/null 2>&1 || true
    "$NFT" add element inet vigil_respond "blocked$fam" "{ $1 timeout ${2}s }"
    say "blocked $1 for ${2}s"
    echo "blocked $1 for ${2}s"
    ;;
  unblock-ip)
    [ $# -eq 1 ] || die "unblock-ip <address>"
    fam=$(family "$1") || die "not an IP address"
    ensure_table
    if "$NFT" delete element inet vigil_respond "blocked$fam" "{ $1 }" >/dev/null 2>&1; then
      say "unblocked $1"; echo "unblocked $1"
    else
      echo "not blocked $1"
    fi
    ;;
  list-blocks)
    [ $# -eq 0 ] || die "list-blocks takes no arguments"
    ensure_table
    for fam in 4 6; do
      "$NFT" -j list set inet vigil_respond "blocked$fam"
    done
    ;;
  check)
    [ $# -eq 0 ] || die "check takes no arguments"
    ensure_table
    echo "ok"
    ;;
  *) die "unknown verb" ;;
esac
